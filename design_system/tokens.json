{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "OrbitalArchitectDesignTokens",
  "version": "1.0.0",
  "tokens": {
    "colors": {
      "background": {
        "primary": "#0A0D14",
        "secondary": "#101622",
        "tertiary": "#161F30",
        "surface": "#1B263B",
        "surface_elevated": "#22314D"
      },
      "border": {
        "subtle": "#1E2B42",
        "default": "#2D3E5E",
        "active": "#3B82F6",
        "highlight": "#60A5FA"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#94A3B8",
        "muted": "#64748B",
        "accent": "#38BDF8"
      },
      "telemetry": {
        "nominal": { "hex": "#10B981", "rgb": "16, 185, 129", "label": "NOMINAL" },
        "caution": { "hex": "#F59E0B", "rgb": "245, 158, 11", "label": "CAUTION" },
        "warning": { "hex": "#EF4444", "rgb": "239, 68, 68", "label": "CRITICAL" },
        "info": { "hex": "#0EA5E9", "rgb": "14, 165, 233", "label": "CARRIER" },
        "disabled": { "hex": "#334155", "rgb": "51, 65, 85", "label": "STANDBY" }
      },
      "subsystems": {
        "payload": "#8B5CF6",
        "power": "#FACC15",
        "thermal": "#F97316",
        "comms": "#06B6D4",
        "propulsion": "#EC4899",
        "adcs": "#14B8A6",
        "cdh": "#3B82F6",
        "structure": "#94A3B8"
      }
    },
    "typography": {
      "font_family": {
        "display": "'Space Grotesk', -apple-system, sans-serif",
        "sans": "'Inter', -apple-system, sans-serif",
        "mono": "'JetBrains Mono', 'SF Mono', monospace"
      },
      "font_size": {
        "xs": "0.6875rem",
        "sm": "0.75rem",
        "base": "0.875rem",
        "md": "1.0rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem"
      },
      "line_height": {
        "tight": "1.15",
        "snug": "1.25",
        "normal": "1.4",
        "relaxed": "1.5"
      }
    },
    "spacing": {
      "grid_base": "4px",
      "panel_padding": "12px",
      "card_padding": "16px",
      "gutter": "8px"
    },
    "borders": {
      "radius_sm": "2px",
      "radius_md": "4px",
      "radius_lg": "6px",
      "width_default": "1px"
    },
    "elevation": {
      "glow_nominal": "0 0 12px rgba(16, 185, 129, 0.25)",
      "glow_warning": "0 0 16px rgba(239, 68, 68, 0.35)",
      "glow_active": "0 0 10px rgba(59, 130, 246, 0.3)"
    }
  }
}
